{
  "name": "media-downloader-extension",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.3",
  "description": "Browser extension that surfaces a download control on media found on the current page, and can download an arbitrary link's media via a native-host/yt-dlp backend.",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcfs31/media-downloader.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.7",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": ">=3.3.18"
    }
  }
}
