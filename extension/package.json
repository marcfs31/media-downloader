{
  "name": "media-downloader-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Browser extension that surfaces a download control on media found on the current page, and can download an arbitrary link's media via a native-host/yt-dlp backend.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/chrome": "^0.0.287",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.19.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  }
}
